---
import { GITHUB_URL } from "@/lib/site";
---
<footer class="border-t-4 border-xp-blue bg-card">
  <div class="mx-auto flex max-w-5xl flex-col gap-3 px-6 py-8 text-sm text-muted-foreground">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <span class="font-display text-2xl tracking-wide text-foreground">notcanva</span>
      <span>MIT License</span>
      <a href={GITHUB_URL} target="_blank" rel="noreferrer" class="underline hover:text-foreground">GitHub</a>
      <span class="font-mono">Made with zero bucks</span>
    </div>
    <p class="text-xs">
      notcanva is an independent open-source project. Not affiliated with, endorsed by, or connected to Canva.
    </p>
  </div>
</footer>
